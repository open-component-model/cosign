# Pins of the OCM overlay. Each "# bump: <group> <source> [<name>]" comment marks the pin on
# the next line for hack/bump-pins.sh on main (docs/maintenance.md#pin-format).
# bump: go-toolchain go
GO_VERSION=1.27.3
# bump: test-tooling github-release kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# bump: test-tooling github-release orhun/git-cliff
GIT_CLIFF_VERSION=v2.14.2
# bump: test-tooling go-module golang.org/x/vuln
GOVULNCHECK_VERSION=v1.9.0
# bump: test-tooling github-release CycloneDX/cyclonedx-gomod
CYCLONEDX_GOMOD_VERSION=v1.12.0
# Sigstore services for e2e (.github/ocm/e2e.sh); a pin change rebuilds the cached images.
# bump: sigstore-e2e-services github-release sigstore/fulcio
FULCIO_VERSION=v1.9.0
# bump: sigstore-e2e-services github-release sigstore/rekor
REKOR_VERSION=v1.5.4
# bump: sigstore-e2e-services github-release sigstore/timestamp-authority
TIMESTAMP_AUTHORITY_VERSION=v2.1.4
# bump: sigstore-e2e-services github-release sigstore/rekor-tiles
REKOR_TILES_VERSION=v2.3.0
# Go test -skip regex for unit tests that fail only under GOFIPS140 (empty = none)
FIPS_SKIP_TESTS=
