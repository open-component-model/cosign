# Build context is dist/ (cosign-<os>-<arch> binaries), not the repo root.
# cosign needs TLS roots and a writable $HOME for its TUF cache ($HOME/.sigstore).
FROM --platform=$BUILDPLATFORM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS base
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /rootfs/home/nonroot /rootfs/tmp && chmod 1777 /rootfs/tmp

FROM scratch
ARG TARGETOS
ARG TARGETARCH
COPY --from=base /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=base --chown=65532:65532 /rootfs/home/nonroot /home/nonroot
COPY --from=base /rootfs/tmp /tmp
COPY cosign-${TARGETOS}-${TARGETARCH} /cosign
ENV HOME=/home/nonroot
USER 65532:65532
ENTRYPOINT ["/cosign"]
