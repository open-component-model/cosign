# renovate: datasource=golang-version depName=go
GO_VERSION=1.27.2
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# Sigstore services for e2e (.github/ocm/e2e.sh); a pin change rebuilds the cached images.
# renovate: datasource=github-releases depName=sigstore/fulcio
FULCIO_VERSION=v1.9.0
# renovate: datasource=github-releases depName=sigstore/rekor
REKOR_VERSION=v1.5.4
# renovate: datasource=github-releases depName=sigstore/timestamp-authority
TIMESTAMP_AUTHORITY_VERSION=v2.1.4
# renovate: datasource=github-releases depName=sigstore/rekor-tiles
REKOR_TILES_VERSION=v2.3.0
# Go test -skip regex for unit tests that fail only under GOFIPS140 (empty = none)
FIPS_SKIP_TESTS=
