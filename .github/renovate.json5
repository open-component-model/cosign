{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  // ocm-main (overlay tooling) plus every maintenance branch ocm/vX.Y.Z.
  baseBranchPatterns: ['$default', '/^ocm\\/v\\d+\\.\\d+\\.\\d+$/'],
  updateNotScheduled: true, // Update branches that have already been created
  prCreation: 'not-pending',
  lockFileMaintenance: {
    enabled: false,
  },
  branchPrefix: 'renovate/',
  gitAuthor: 'ocmbot[bot] <125909804+ocmbot[bot]@users.noreply.github.com>',
  gitIgnoredAuthors: [
    '125909804+ocmbot[bot]@users.noreply.github.com',
  ],
  // One update branch at a time across the repo: the next group starts only after the
  // previous one merged (or failed into a PR), so a break is attributable to one library.
  // Security updates ignore this limit. prPriority below decides which group goes next.
  branchConcurrentLimit: 1,
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  automerge: true, // no review
  automergeType: 'branch', // fast-forward onto base after green CI, auto-rebase, PR only on failure
  separateMinorPatch: true,
  // Jump straight to the newest major instead of one branch per intermediate major.
  separateMultipleMajor: false,
  // GitHub Dependabot alerts only cover the default branch.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    automerge: true,
    automergeType: 'branch',
    labels: ['security'],
  },
  packageRules: [
    {
      // Control branch (overlay tooling), weekly. Later rules split Sigstore e2e services
      // and the Go toolchain out of the .env regex manager.
      matchBaseBranches: ['ocm-main'],
      matchManagers: ['github-actions', 'dockerfile', 'custom.regex'],
      separateMinorPatch: false,
      prPriority: 5,
      schedule: [
        '* * * * 0', // At every minute on Sunday it is allowed to create branches
      ],
    },
    {
      matchBaseBranches: ['ocm-main'],
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      groupSlug: 'github-actions',
    },
    {
      // debian base image of the overlay Containerfile.
      matchBaseBranches: ['ocm-main'],
      matchManagers: ['dockerfile'],
      groupName: 'Container base images',
      groupSlug: 'base-images',
    },
    {
      // kind and other test tools pinned in overlay .env.
      matchBaseBranches: ['ocm-main'],
      matchManagers: ['custom.regex'],
      groupName: 'Test tooling',
      groupSlug: 'test-tooling',
    },
    {
      // Sigstore services the e2e runs against (overlay .env pins). Own group so a
      // failing service bump never holds back action/image updates.
      matchBaseBranches: ['ocm-main'],
      matchDepNames: ['sigstore/fulcio', 'sigstore/rekor', 'sigstore/timestamp-authority', 'sigstore/rekor-tiles'],
      groupName: 'Sigstore e2e services',
      groupSlug: 'sigstore-e2e-services',
    },
    {
      // Go toolchain: own group, any time (stdlib security fixes).
      matchBaseBranches: ['ocm-main'],
      matchDatasources: ['golang-version'],
      groupName: 'Go toolchain',
      groupSlug: 'go-toolchain',
      prPriority: 10,
      schedule: ['at any time'],
    },
    {
      // Maintenance branches: everything off. Overlay files there are written
      // only by Sync upstream, so its refresh never fights Renovate.
      matchBaseBranches: ['/^ocm\\/v/'],
      enabled: false,
    },
    {
      // ... except Go modules (direct and indirect). This must not use matchUpdateTypes:
      // `enabled` is decided before lookup, when the update type is still unknown, so a
      // type-scoped re-enable never matches and every module stays disabled.
      // separateMinorPatch shapes update types, so it cannot sit in a rule with
      // matchUpdateTypes either.
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      enabled: true,
      separateMinorPatch: false,
      postUpdateOptions: ['gomodTidy'],
      // One group per library (source repository, e.g. all aws-sdk-go-v2 modules
      // together); branchConcurrentLimit serializes them.
      groupName: '{{#if sourceRepo}}{{{sourceRepo}}}{{else}}{{{depName}}}{{/if}}',
      groupSlug: 'go-{{#if sourceRepo}}{{{replace "/" "-" sourceRepo}}}{{else}}{{{replace "/" "-" depName}}}{{/if}}',
    },
    // Library families on maintenance branches (after the per-repository fallback, so
    // these win). Modeled on OCM's groups; every module not listed keeps its own branch.
    {
      // aws-sdk-go-v2 and smithy-go release together
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/aws/{/,}**'],
      groupName: 'AWS SDK',
      groupSlug: 'go-aws',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/Azure/{/,}**', 'github.com/AzureAD/{/,}**'],
      groupName: 'Azure SDK',
      groupSlug: 'go-azure',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/alibabacloud-go/{/,}**', 'github.com/aliyun/{/,}**', 'github.com/AliyunContainerService/{/,}**'],
      groupName: 'Alibaba Cloud SDK',
      groupSlug: 'go-alibaba-cloud',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['cloud.google.com/go{/,}**', 'github.com/googleapis/{/,}**', 'google.golang.org/api{/,}**'],
      groupName: 'Google Cloud SDK',
      groupSlug: 'go-google-cloud',
    },
    {
      // grpc, protobuf, genproto (as in OCM)
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['google.golang.org/{/,}**', '!google.golang.org/api{/,}**', 'github.com/grpc-ecosystem/{/,}**'],
      groupName: 'Google Golang Repositories',
      groupSlug: 'go-google-golang-repos',
    },
    {
      // as in OCM
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['golang.org/x/{/,}**'],
      groupName: 'Golang X Repositories',
      groupSlug: 'go-golang-x-repos',
    },
    {
      // as in OCM; apimachinery/kube-openapi/structured-merge-diff must move together
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['k8s.io/{/,}**', 'sigs.k8s.io/{/,}**'],
      groupName: 'Kubernetes dependencies',
      groupSlug: 'go-kubernetes-deps',
    },
    {
      // as in OCM
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/docker/{/,}**', 'github.com/moby/{/,}**'],
      groupName: 'Docker dependencies',
      groupSlug: 'go-docker-deps',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['go.opentelemetry.io/{/,}**'],
      groupName: 'OpenTelemetry',
      groupSlug: 'go-opentelemetry',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/go-openapi/{/,}**'],
      groupName: 'go-openapi',
      groupSlug: 'go-go-openapi',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/google/go-containerregistry{/,}**', 'github.com/opencontainers/{/,}**', 'github.com/containerd/{/,}**'],
      groupName: 'OCI / container registry',
      groupSlug: 'go-oci',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/lestrrat-go/{/,}**', 'github.com/go-jose/{/,}**', 'github.com/golang-jwt/{/,}**', 'github.com/coreos/go-oidc{/,}**'],
      groupName: 'JOSE / JWT',
      groupSlug: 'go-jose-jwt',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/theupdateframework/{/,}**', 'github.com/in-toto/{/,}**', 'github.com/secure-systems-lab/{/,}**', 'github.com/transparency-dev/{/,}**', 'github.com/google/certificate-transparency-go{/,}**', 'github.com/google/trillian{/,}**'],
      groupName: 'TUF / in-toto / transparency',
      groupSlug: 'go-supply-chain',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/tink-crypto/{/,}**'],
      groupName: 'Tink',
      groupSlug: 'go-tink',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/hashicorp/{/,}**'],
      groupName: 'HashiCorp',
      groupSlug: 'go-hashicorp',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/prometheus/{/,}**'],
      groupName: 'Prometheus',
      groupSlug: 'go-prometheus',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/buildkite/{/,}**'],
      groupName: 'Buildkite',
      groupSlug: 'go-buildkite',
    },
    {
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['cuelang.org/{/,}**', 'cuelabs.dev/{/,}**'],
      groupName: 'CUE',
      groupSlug: 'go-cue',
    },
    {
      // as in OCM
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/spf13/{/,}**'],
      groupName: 'spf13 repositories',
      groupSlug: 'go-spf13',
    },
    {
      // No majors: a Go major is a new module path. Indirect majors are no-ops (importers
      // keep the old path, tidy drops the new one); direct majors need cosign source
      // changes, which belong upstream and arrive with new upstream tags/branches.
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // Indirect modules without releases (pseudo-versions) follow their importers via
      // MVS instead of jumping to their default-branch tip, which breaks version sets:
      // e.g. k8s.io/kube-openapi tip needs structured-merge-diff/v7 while apimachinery
      // v0.37 still passes v6 types; google.golang.org/genproto tip dropped
      // googleapis/cloud/kms/v1, still imported by tink-go-gcpkms tests. Tagged indirect
      // modules keep updating.
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchUpdateTypes: ['digest'],
      enabled: false,
    },
    {
      // cosign's own ecosystem moves in lockstep with cosign source: rekor v1.5.4 added
      // CreateLogEntryContext to its generated client (cosign's mock no longer compiles),
      // timestamp-authority v2.1.3 broke the TSA e2e tests. Newer versions arrive with
      // new upstream cosign tags, i.e. new maintenance branches.
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/sigstore/**'],
      enabled: false,
    },
    {
      // The Go version comes from overlay GO_VERSION, never from go.mod directives.
      matchBaseBranches: ['/^ocm\\/v/'],
      matchManagers: ['gomod'],
      matchDepTypes: ['golang', 'toolchain'],
      enabled: false,
    },
    {
      // Renamed to github.com/ThalesGroup/crypto11 at v1.5.0. Bumps past v1.4.x
      // on the old path fail the go.sum artifact step with a module-path
      // mismatch (OCM #2966, #3379).
      matchManagers: ['gomod'],
      matchDepNames: ['github.com/ThalesIgnite/crypto11'],
      enabled: false,
    },
  ],
  customManagers: [
    {
      // # renovate: datasource=<ds> depName=<name>
      // <NAME>_VERSION=<version>
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)\\.env$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+.*?_VERSION=v?(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      versioningTemplate: 'semver',
    },
  ],
}
